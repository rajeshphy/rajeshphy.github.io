/* Accelerated-charge, dipole, and antenna checks. */
kill(all)$
declare(theta,real,beta,real,a,real)$
assume(a>0,beta>0,beta<1)$

residual_solid_angle : trigsimp(integrate(sin(theta)^3,theta,0,%pi)-4/3)$
print("Larmor angular-integral residual = ",residual_solid_angle)$

gamma : 1/sqrt(1-beta^2)$
residual_perpendicular : radcan(gamma^6*a^2*(1-beta^2)-gamma^4*a^2)$
residual_parallel : radcan(gamma^6*a^2*(a^2/a^2)-gamma^6*a^2)$
print("Lienard perpendicular-limit residual = ",residual_perpendicular)$
print("Lienard parallel-limit residual = ",residual_parallel)$

declare(mu,real)$
Iparallel : integrate((1-mu^2)/(1-beta*mu)^5,mu,-1,1)$
Iperpendicular : integrate(
 ((1+beta^2)*(1+mu^2)-4*beta*mu)/(2*(1-beta*mu)^5),
 mu,-1,1)$
print("Lienard parallel angular-integral residual = ",
 radcan(Iparallel-4/(3*(1-beta^2)^3)))$
print("Lienard perpendicular angular-integral residual = ",
 radcan(Iperpendicular-4/(3*(1-beta^2)^2)))$

/* p0=I0*l/omega maps the dipole power to the short-element form. */
residual_element : ratsimp((I0*l/omega)^2*omega^4-I0^2*l^2*omega^2)$
print("small-current-element substitution residual = ",residual_element)$

/* Four-element geometric sum. */
array_sum : 1+z+z^2+z^3$
residual_array : ratsimp(array_sum-(1-z^4)/(1-z))$
print("four-element array-factor residual = ",residual_array)$

/* Current-element radiation resistance. */
P_element : Z0*Ipk^2*(k*l)^2/(12*%pi)$
R_radiation : 2*P_element/Ipk^2$
print("current-element radiation-resistance residual = ",
 ratsimp(R_radiation-Z0*(k*l)^2/(6*%pi)))$

/* Solved problem 1: fraction in the 60--120 degree belt. */
belt_integral : 11/12$
total_integral : 4/3$
print("equatorial-belt power-fraction residual = ",
 ratsimp(belt_integral/total_integral-11/16))$

/* Solved problem 2: half-wave half-power beamwidth. */
gpat(x) := cos((%pi/2)*cos(x))/sin(x)$
gpat_prime(x) := ((%pi/2)*sin((%pi/2)*cos(x))*sin(x)^2
 -cos((%pi/2)*cos(x))*cos(x))/sin(x)^2$
theta0 : 0.900$
theta1 : theta0-(gpat(theta0)-1/sqrt(2))/gpat_prime(theta0)$
theta2 : theta1-(gpat(theta1)-1/sqrt(2))/gpat_prime(theta1)$
theta3 : theta2-(gpat(theta2)-1/sqrt(2))/gpat_prime(theta2)$
theta_hp : find_root(gpat(x)-1/sqrt(2),x,0.7,1.2)$
theta_deg : theta_hp*180/%pi$
hpbw_deg : 180-2*theta_deg$
half_power_residual :
 (round(theta1*1e7)-8894022)^2
 +(round(theta2*1e7)-8894397)^2
 +(round(theta3*1e7)-8894397)^2
 +(round(theta_hp*1e7)-8894397)^2
 +(round(theta_deg*1000)-50961)^2
 +(round(hpbw_deg*1000)-78078)^2
 +(round((gpat(theta_hp)^2-0.5)*1e12))^2$
print("half-wave half-power numerical residual = ",half_power_residual)$

/* Numerical-problem answer checks; rounding matches the printed precision. */
c0 : 299792458.0$
eps0 : 8.8541878128e-12$
q0 : 1.602176634e-19$
mu0 : 1.25663706212e-6$
Zvac : sqrt(mu0/eps0)$

P_larmor_num : q0^2*(2e17)^2/(6*%pi*eps0*c0^3)$
print("Larmor-power numerical residual = ",
 (round(P_larmor_num*1e22)-2283)^2)$

gamma08 : 1/sqrt(1-0.8^2)$
P_lienard_num : q0^2*gamma08^4*(5e15)^2/(6*%pi*eps0*c0^3)$
print("Lienard-power numerical residual = ",
 (round(P_lienard_num*1e24)-1101)^2)$

omega_d : 2*%pi*50e6$
P_dipole_num : (3e-12)^2*omega_d^4/(12*%pi*eps0*c0^3)$
print("dipole-power numerical residual = ",
 (round(P_dipole_num*1e9)-9748)^2)$

k_element : 2*%pi*300e6/c0$
P_element_num : Zvac*2^2*(k_element*0.020)^2/(12*%pi)$
R_element_num : 2*P_element_num/2^2$
print("current-element numerical residual = ",
 (round(P_element_num*1e4)-6321)^2
 +(round(R_element_num*1e4)-3160)^2
 +(round(Zvac/(6*%pi))-20)^2)$

theta_array : acos(1/3)*180/%pi$
theta_null : acos(2/3)*180/%pi$
print("six-element array numerical residual = ",
 (round(theta_array*1000)-70529)^2
 +(round(theta_null*1000)-48190)^2+(6^2-36)^2)$
