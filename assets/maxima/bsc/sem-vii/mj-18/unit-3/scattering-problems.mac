/* UG-VII MJ-18 Unit III: scattering problem checks. */
kill(all)$
declare(a,real,q,real)$
assume(a>0)$
round_to(x,n) := round(float(x)*10^n)/10^n$

/* Solved problem 1: Gaussian Born transform. */
gaussian_1d : integrate(exp(-x^2/a^2-%i*q*x),x,minf,inf)$
print("Gaussian one-dimensional transform residual = ",radcan(gaussian_1d-sqrt(%pi)*a*exp(-a^2*q^2/4)))$
gaussian_3d : %pi^(3/2)*a^3*exp(-a^2*q^2/4)$
f_born : -mu/(2*%pi*hbar^2)*V0*gaussian_3d$
print("Gaussian Born-amplitude residual = ",radcan(f_born+mu*V0*sqrt(%pi)*a^3*exp(-a^2*q^2/4)/(2*hbar^2)))$
print("Gaussian Born-cross-section residual = ",radcan(f_born^2-%pi*mu^2*V0^2*a^6*exp(-a^2*q^2/2)/(4*hbar^4)))$

/* Solved problem 2: partial waves and optical theorem. */
k : 2$
d0 : %pi/6$
d1 : %pi/18$
phase_sum : sin(d0)^2+3*sin(d1)^2$
sigma : 4*%pi/k^2*phase_sum$
im_forward : phase_sum/k$
print("two-wave optical-theorem residual = ",radcan(sigma-4*%pi*im_forward/k))$
print("ten-degree sine-square rounding residual = ",round_to(sin(d1)^2,7)-301537/10^7)$
print("two-wave cross-section rounding residual = ",round_to(sigma,5)-106959/100000)$
print("forward-amplitude rounding residual = ",round_to(im_forward,6)-170231/10^6)$

/* Solved problem 3: effective range. */
asc : 5$
re : 3/2$
ke : 1/10$
kcot : -1/asc+re*ke^2/2$
sigma_eff : 4*%pi/(kcot^2+ke^2)$
print("effective-range k-cotangent residual = ",ratsimp(kcot+77/400))$
print("effective-range cross-section residual = ",radcan(sigma_eff-640000*%pi/7529))$
print("threshold limiting cross-section residual = ",radcan(4*%pi*asc^2-100*%pi))$
print("effective-range cross-section rounding residual = ",round_to(sigma_eff,3)-26705/100)$
print("threshold limiting rounding residual = ",round_to(100*%pi,3)-314159/1000)$

/* Numerical problems. */
amp60 : (2/5)*cos(%pi/3)$
diff60 : amp60^2$
total_cos : (2/5)^2*4*%pi/3$
print("angular differential-cross-section residual = ",radcan(diff60-1/25))$
print("cosine total-cross-section residual = ",radcan(total_cos-16*%pi/75))$
print("cosine total-cross-section rounding residual = ",round_to(total_cos,6)-335103/500000)$

s : 1/5$
C : (2*%pi*s^2)^(-3/4)$
print("packet normalization residual = ",radcan(C^2*(2*%pi*s^2)^(3/2)-1))$
print("packet normalization rounding residual = ",round_to(C,3)-2817/1000)$

qtransfer : 2*5*sin(%pi/6)$
print("momentum-transfer residual = ",radcan(qtransfer-5))$

kappaC : 36/25$
energy : 1000$
rutherford : kappaC^2/(16*energy^2*sin(%pi/12)^4)$
print("Rutherford formula residual = ",radcan(rutherford-kappaC^2/(16*energy^2*sin(%pi/12)^4)))$
print("Rutherford rounding residual = ",round_to(rutherford*10^5,5)-57763/20000)$
