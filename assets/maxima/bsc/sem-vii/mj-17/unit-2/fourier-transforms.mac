/* Gaussian, finite-train, derivative, and convolution checks. */
kill(all)$
declare(a,real,L,real,k,real,k0,real)$
assume(a>0,L>0)$

gaussian : integrate(exp(-a*x^2)*exp(-%i*k*x),x,minf,inf)$
gaussian_expected : sqrt(%pi/a)*exp(-k^2/(4*a))$
print("Gaussian-transform residual = ",radcan(gaussian-gaussian_expected))$

finite_train : integrate(cos(k0*x)*exp(-%i*k*x),x,-L/2,L/2)$
finite_expected : sin((k-k0)*L/2)/(k-k0)+sin((k+k0)*L/2)/(k+k0)$
print("finite-wave-train residual = ",radcan(exponentialize(finite_train-finite_expected)))$

/* Derivative theorem for the Gaussian. */
gaussian_derivative : integrate(diff(exp(-a*x^2),x)*exp(-%i*k*x),x,minf,inf)$
print("Fourier-derivative residual = ",radcan(gaussian_derivative-%i*k*gaussian_expected))$

/* Convolution of two exp(-x)H(x) functions is x exp(-x)H(x). */
conv : integrate(exp(-u)*exp(-(x-u)),u,0,x)$
print("convolution residual = ",ratsimp(conv-x*exp(-x)))$

/* Enhanced solved-problem and final-answer checks. */
two_sided : integrate(exp((a-%i*k)*x),x,minf,0)
          + integrate(exp(-(a+%i*k)*x),x,0,inf)$
print("two-sided exponential transform residual = ",radcan(two_sided-2*a/(a^2+k^2)))$
print("two-sided exponential zero-frequency residual = ",radcan(ev(two_sided,k=0)-2/a))$

triangle_transform : 2*integrate((L-x)*cos(k*x),x,0,L)$
triangle_expected : 4*sin(k*L/2)^2/k^2$
print("triangular convolution transform residual = ",radcan(exponentialize(triangle_transform-triangle_expected)))$
print("triangular convolution zero-frequency residual = ",radcan(limit(triangle_expected,k,0)-L^2))$

y_plus : exp(-a*x)/(2*a)$
y_minus : exp(a*x)/(2*a)$
print("Green-function positive-half-line residual = ",radcan(-diff(y_plus,x,2)+a^2*y_plus))$
print("Green-function negative-half-line residual = ",radcan(-diff(y_minus,x,2)+a^2*y_minus))$
print("Green-function derivative-jump residual = ",radcan(at(diff(y_plus,x),x=0)-at(diff(y_minus,x),x=0)+1))$

problem_1 : ev(gaussian_expected,a=4,k=4)$
problem_2_F0 : limit(2*sin(k*L/2)/k,k,0)$
problem_2_zero : ev(2*sin(k*L/2)/k,k=2*%pi/L)$
problem_3_peak : limit(finite_expected,k,k0)$
problem_4_transform : -%i*k*sqrt(%pi)*exp(-k^2/4)/2$
problem_5_transform : 3*exp(-2*%i*k)-exp(%i*k)$
problem_6_conv : integrate(exp(-u)*exp(-2*(x-u)),u,0,x)$
print("Gaussian numerical residual = ",radcan(problem_1-sqrt(%pi)/(2*%e)))$
print("rectangular-pulse area residual = ",radcan(problem_2_F0-L))$
print("rectangular-pulse first-zero residual = ",radcan(problem_2_zero))$
print("finite-train peak-limit residual = ",radcan(exponentialize(problem_3_peak-(L/2+sin(k0*L)/(2*k0)))))$
print("x-Gaussian derivative-rule residual = ",radcan(problem_4_transform-%i*diff(sqrt(%pi)*exp(-k^2/4),k)))$
print("x-Gaussian k=2 residual = ",radcan(ev(problem_4_transform,k=2)+%i*sqrt(%pi)/%e))$
print("shifted-delta k=pi residual = ",radcan(exponentialize(ev(problem_5_transform,k=%pi)-4)))$
print("unequal-exponential convolution residual = ",radcan(problem_6_conv-(exp(-x)-exp(-2*x))))$
print("unequal-exponential x=log(2) residual = ",radcan(exponentialize(ev(problem_6_conv,x=log(2))-1/4)))$
