/* MJ-5 Unit III: white-dwarf scaling and black-hole calculations. */
kill(all)$

/* Symbolic cancellation at the heuristic Chandrasekhar mass scale. */
assume(hbar>0,c_light>0,Gs>0,M>0,mu_e>0,m_u>0,R>0)$
Ne:M/(mu_e*m_u)$
K:hbar*c_light*Ne^(4/3)/R$
W:-Gs*M^2/R$
Mlim:(hbar*c_light/Gs)^(3/2)/(mu_e*m_u)^2$
print("mass_balance_residual =",radcan(subst(Mlim,M,K+W)))$

/* Standard ideal value 5.83/mu_e^2 in solar masses. */
print("mu_e_two_mass_residual =",ratsimp(5.83/2^2-1.4575))$

G:6.67430e-11$
M_sun:1.98847e30$
c:299792458$
r_s_10:2*G*(10*M_sun)/c^2/1000$
print("schwarzschild_radius_rounding_residual =",round(1e3*r_s_10)-29533)$

/* Independent numerical exercises. */
print("redshift_rounding_residual =",
      round(1e6*(sqrt(3/2)-1))-224745)$
rho:3*M_sun/(4*%pi*(7000e3)^3)$
print("white_dwarf_density_rounding_residual =",round(rho/1e3)-1384001)$
