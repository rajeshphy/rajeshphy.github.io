/* MJ-5 Unit III: Raman and Bose-Einstein calculations. */
kill(all)$

lambda0_cm:532e-7$
wn0:1/lambda0_cm$
shift:1000$
lambda_stokes_nm:1e7/(wn0-shift)$
print("stokes_wavelength_rounding_residual =",
      round(1000*lambda_stokes_nm)-561893)$

/* hc=1.239841984e-4 eV cm and hc/k=1.438776877 K cm. */
print("raman_energy_rounding_residual =",
      round(1e6*(1.239841984e-4*shift))-123984)$
print("population_ratio_rounding_residual =",
      round(1e6*exp(-1.438776877*shift/300))-8263)$

print("bose_occupation_rounding_residual =",
      round(1e6/(exp(2)-1))-156518)$

/* Independent numerical exercises. */
photon_rate:2e-6*560e-9/(6.62607015e-34*299792458)$
print("photon_rate_rounding_residual =",round(photon_rate/1e9)-5638)$
print("condensate_fraction_rounding_residual =",
      round(1e6*(1-(1/2)^(3/2)))-646447)$
print("be_mb_percent_rounding_residual =",
      round(1e6*100*(1/(1-exp(-5))-1))-678365)$
