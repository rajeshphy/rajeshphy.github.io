/* MJ-11 Unit III: square-well equations; every printed residual must vanish. */
kill(all)$
assume(a>0,k>0,kap>0,m>0,hbar>0)$

even_inside:cos(k*x)$
even_outside:cos(k*a)*exp(-kap*(x-a))$
even_inside_ode_residual:ratsimp(diff(even_inside,x,2)+k^2*even_inside)$
even_outside_ode_residual:ratsimp(diff(even_outside,x,2)-kap^2*even_outside)$
even_value_residual:ratsimp(subst(x=a,even_inside-even_outside))$
even_derivative_residual:trigsimp(
  subst(kap=k*tan(k*a),subst(x=a,diff(even_inside,x)-diff(even_outside,x))))$

odd_inside:sin(k*x)$
odd_outside:sin(k*a)*exp(-kap*(x-a))$
odd_inside_ode_residual:ratsimp(diff(odd_inside,x,2)+k^2*odd_inside)$
odd_outside_ode_residual:ratsimp(diff(odd_outside,x,2)-kap^2*odd_outside)$
odd_value_residual:ratsimp(subst(x=a,odd_inside-odd_outside))$
odd_derivative_residual:trigsimp(
  subst(kap=-k*cot(k*a),subst(x=a,diff(odd_inside,x)-diff(odd_outside,x))))$

V0:hbar^2*(k^2+kap^2)/(2*m)$
Einside:-V0+hbar^2*k^2/(2*m)$
Eoutside:-hbar^2*kap^2/(2*m)$
energy_identity_residual:ratsimp(Einside-Eoutside)$

print("even_inside_ode_residual =",even_inside_ode_residual)$
print("even_outside_ode_residual =",even_outside_ode_residual)$
print("even_value_residual =",even_value_residual)$
print("even_derivative_residual =",even_derivative_residual)$
print("odd_inside_ode_residual =",odd_inside_ode_residual)$
print("odd_outside_ode_residual =",odd_outside_ode_residual)$
print("odd_value_residual =",odd_value_residual)$
print("odd_derivative_residual =",odd_derivative_residual)$
print("energy_identity_residual =",energy_identity_residual)$
quit();
