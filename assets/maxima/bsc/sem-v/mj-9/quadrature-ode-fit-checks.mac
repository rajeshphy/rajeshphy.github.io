/* MJ-9 Unit II: exact residual checks for quadrature, RK4, and a fitted line. */
f(x):=x^3-2*x+4$
exact_integral:integrate(f(x),x,0,2)$
simpson:(2/6)*(f(0)+4*f(1)+f(2))$
simpson_residual:ratsimp(simpson-exact_integral);
g(x):=x^2+2*x+3$
gauss2:g(-1/sqrt(3))+g(1/sqrt(3))$
gauss_residual:ratsimp(gauss2-integrate(g(x),x,-1,1));
/* One RK4 step for y'=y: compare with the fourth-degree Taylor update. */
k1:h*y$ k2:h*(y+k1/2)$ k3:h*(y+k2/2)$ k4:h*(y+k3)$
rk4:y+(k1+2*k2+2*k3+k4)/6$
taylor4:y*(1+h+h^2/2+h^3/6+h^4/24)$
rk4_residual:ratsimp(expand(rk4-taylor4));
/* Least-squares line through (0,1),(1,3),(2,5). */
a:1$ b:2$
normal_residual_1:ratsimp(3*a+3*b-(1+3+5));
normal_residual_2:ratsimp(3*a+5*b-(0*1+1*3+2*5));
/* Quadratic fit 1+x^2 through (-1,2),(0,1),(1,2),(2,5). */
c0:1$ c1:0$ c2:1$
polynomial_residual_0:ratsimp(4*c0+2*c1+6*c2-10);
polynomial_residual_1:ratsimp(2*c0+6*c1+8*c2-10);
polynomial_residual_2:ratsimp(6*c0+8*c1+18*c2-24);
quit();
