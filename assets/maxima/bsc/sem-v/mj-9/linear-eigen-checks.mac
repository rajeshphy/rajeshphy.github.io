/* MJ-9 Unit I: exact checks for LU, the linear-system solution, and eigenpairs. */
A: matrix([4,1,1],[2,5,2],[1,2,4])$
L: matrix([1,0,0],[1/2,1,0],[1/4,7/18,1])$
U: matrix([4,1,1],[0,9/2,3/2],[0,0,19/6])$
b: matrix([6],[3],[7])$
x: matrix([23/19],[-11/19],[33/19])$
lu_residual: ratsimp(A-L.U);
solution_residual: ratsimp(A.x-b);
B: matrix([2,1],[1,2])$
q1: matrix([1],[1])$
q2: matrix([1],[-1])$
eigen_residual_1: ratsimp(B.q1-3*q1);
eigen_residual_2: ratsimp(B.q2-q2);
quit();
