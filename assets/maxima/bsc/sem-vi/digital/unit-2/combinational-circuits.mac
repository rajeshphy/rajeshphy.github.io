/* UG-VI MJ-14 Unit II: exhaustive Boolean checks. */
kill(all)$

bnot(x) := 1-x$
band2(x,y) := x*y$
bor2(x,y) := 1-(1-x)*(1-y)$
bxor2(x,y) := x+y-2*x*y$
bxnor2(x,y) := 1-bxor2(x,y)$
bnand2(x,y) := bnot(band2(x,y))$
bnor2(x,y) := bnot(bor2(x,y))$
bit(n,k) := mod(quotient(n,2^k),2)$

/* NAND-only and NOR-only realizations of NOT, AND and OR. */
universal_gate_residuals : makelist(
  block([a:bit(n,1),b:bit(n,0)],
    [bnand2(a,a)-bnot(a),
     bnand2(bnand2(a,b),bnand2(a,b))-band2(a,b),
     bnand2(bnand2(a,a),bnand2(b,b))-bor2(a,b),
     bnor2(a,a)-bnot(a),
     bnor2(bnor2(a,b),bnor2(a,b))-bor2(a,b),
     bnor2(bnor2(a,a),bnor2(b,b))-band2(a,b)]),
  n,0,3)$
universal_gate_check : sum(
  sum(abs(universal_gate_residuals[i][j]),j,1,length(universal_gate_residuals[i])),
  i,1,length(universal_gate_residuals))$
print("universal-gate check =", universal_gate_check)$

/* Full-adder equations must reproduce ordinary three-bit addition. */
full_adder_residuals : makelist(
  block([a:bit(n,2),b:bit(n,1),ci:bit(n,0),s,co],
    s:bxor2(bxor2(a,b),ci),
    co:bor2(band2(a,b),band2(ci,bxor2(a,b))),
    a+b+ci-(s+2*co)),
  n,0,7)$
full_adder_check : sum(abs(full_adder_residuals[i]),i,1,8)$
print("full-adder arithmetic check =", full_adder_check)$

/* Full-subtractor equations use A-B-Bin = D-2 Bout. */
full_subtractor_residuals : makelist(
  block([a:bit(n,2),b:bit(n,1),bi:bit(n,0),d,bo],
    d:bxor2(bxor2(a,b),bi),
    bo:bor2(band2(bnot(a),b),band2(bi,bnot(bxor2(a,b)))),
    a-b-bi-(d-2*bo)),
  n,0,7)$
full_subtractor_check : sum(abs(full_subtractor_residuals[i]),i,1,8)$
print("full-subtractor arithmetic check =", full_subtractor_check)$

/* Four-to-one multiplexer, tested for all data and select words. */
mux_residuals : makelist(
  block([data:quotient(n,4),sel:mod(n,4),i0,i1,i2,i3,s1,s0,y,chosen],
    i0:bit(data,0), i1:bit(data,1), i2:bit(data,2), i3:bit(data,3),
    s1:bit(sel,1), s0:bit(sel,0),
    y:bor2(bor2(band2(band2(bnot(s1),bnot(s0)),i0),
                 band2(band2(bnot(s1),s0),i1)),
           bor2(band2(band2(s1,bnot(s0)),i2),
                 band2(band2(s1,s0),i3))),
    chosen:bit(data,sel),
    y-chosen),
  n,0,63)$
mux_check : sum(abs(mux_residuals[i]),i,1,64)$
print("4-to-1 multiplexer check =", mux_check)$

/* Two-to-four decoder is one-hot; a one-hot encoder recovers its input. */
decoder_encoder_residuals : makelist(
  block([a1:bit(n,1),a0:bit(n,0),d0,d1,d2,d3,e1,e0],
    d0:band2(bnot(a1),bnot(a0)),
    d1:band2(bnot(a1),a0),
    d2:band2(a1,bnot(a0)),
    d3:band2(a1,a0),
    e1:bor2(d2,d3), e0:bor2(d1,d3),
    [d0+d1+d2+d3-1,e1-a1,e0-a0]),
  n,0,3)$
decoder_encoder_check : sum(
  sum(abs(decoder_encoder_residuals[i][j]),j,1,3),i,1,4)$
print("decoder/encoder check =", decoder_encoder_check)$

/* One-bit comparator outputs are mutually exclusive and exhaustive. */
comparator_residuals : makelist(
  block([a:bit(n,1),b:bit(n,0),g,e,l],
    g:band2(a,bnot(b)), e:bxnor2(a,b), l:band2(bnot(a),b),
    [g+e+l-1,g*l,g*e,l*e]),
  n,0,3)$
comparator_check : sum(
  sum(abs(comparator_residuals[i][j]),j,1,4),i,1,4)$
print("one-bit comparator check =", comparator_check)$

/* ASCII decimal digits are 0011 followed by the 8421 BCD nibble. */
bcd_ascii_residuals : makelist((2^5+2^4+d)-(48+d),d,0,9)$
print("BCD-to-ASCII digit check =", sum(abs(bcd_ascii_residuals[i]),i,1,10))$

/* Solved problem 1: realize sum m(1,2,6,7) with A,B as mux selects. */
worked_mux_target(n) := if member(n,[1,2,6,7]) then 1 else 0$
worked_mux_output(n) := block(
  [a:bit(n,2),b:bit(n,1),c:bit(n,0),sel],
  sel:2*a+b,
  if sel=0 then c elseif sel=1 then bnot(c) elseif sel=2 then 0 else 1)$
worked_mux_check : sum(abs(worked_mux_output(n)-worked_mux_target(n)),n,0,7)$
print("worked mux realization check =", worked_mux_check)$

/* Solved problem 2: 1011_2 + 0110_2 = 1 0001_2. */
ripple_sum_check : 11+6-17$
ripple_low_word_check : mod(11+6,16)-1$
ripple_carry_check : quotient(11+6,16)-1$
print("worked ripple-adder value check =", ripple_sum_check)$
print("worked ripple-adder low-word check =", ripple_low_word_check)$
print("worked ripple-adder carry check =", ripple_carry_check)$

/* Exercise answers: decoder, subtractor, timing, margins, power, comparator. */
decoder_cover_check : sum(
  abs((if member(n,[1,4,6]) then 1 else 0)-
      (if n=1 or n=4 or n=6 then 1 else 0)),n,0,7)$
specific_subtractor_check : 0-1-1-(0-2*1)$
clock_period_check : 22/10+65/10+13/10-10$
clock_frequency_check : 1000/10-100$
high_margin_check : 44/10-35/10-9/10$
low_margin_check : 15/10-4/10-11/10$
dynamic_power_check : (1/5)*30*10^(-12)*(33/10)^2*50*10^6-3267/10^6$
word_comparator_check : 45-43-2$
print("decoder-cover check =", decoder_cover_check)$
print("specific full-subtractor check =", specific_subtractor_check)$
print("minimum clock-period check (ns) =", clock_period_check)$
print("maximum clock-frequency check (MHz) =", clock_frequency_check)$
print("high noise-margin check (V) =", high_margin_check)$
print("low noise-margin check (V) =", low_margin_check)$
print("CMOS dynamic-power check (W) =", dynamic_power_check)$
print("six-bit comparator check =", word_comparator_check)$
