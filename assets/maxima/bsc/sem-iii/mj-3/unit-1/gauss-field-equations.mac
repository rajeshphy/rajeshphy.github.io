/* MJ-3 Unit I: exact checks for Gauss-law applications and field equations. */
kill(all)$

print("MJ-3 Unit I -- Gauss law and field equations")$

E_in  : rho*r/(3*eps0)$
E_out : rho*R^3/(3*eps0*r^2)$

res_div_in  : ratsimp(diff(r^2*E_in,r)/r^2-rho/eps0)$
res_div_out : ratsimp(diff(r^2*E_out,r)/r^2)$
res_surface : ratsimp(subst(R,r,E_in)-subst(R,r,E_out))$

print("uniform sphere, interior divergence residual =",res_div_in)$
print("uniform sphere, exterior divergence residual =",res_div_out)$
print("uniform sphere, field-continuity residual =",res_surface)$

V_in : rho*(3*R^2-r^2)/(6*eps0)$
V_out: rho*R^3/(3*eps0*r)$

lap_radial(expr) := diff(r^2*diff(expr,r),r)/r^2$

res_poisson : ratsimp(lap_radial(V_in)+rho/eps0)$
res_laplace : ratsimp(lap_radial(V_out))$
res_E_in    : ratsimp(-diff(V_in,r)-E_in)$
res_E_out   : ratsimp(-diff(V_out,r)-E_out)$

print("Poisson-equation residual =",res_poisson)$
print("Laplace-equation residual =",res_laplace)$
print("interior E=-grad(V) residual =",res_E_in)$
print("exterior E=-grad(V) residual =",res_E_out)$

/* Enhancement checks: solved problems and numerical answers. */
E_shell_mid : rho*(r^3-a^3)/(3*eps0*r^2)$
E_shell_out : rho*(b^3-a^3)/(3*eps0*r^2)$
res_shell_mid_gauss :
  ratsimp(4*%pi*r^2*E_shell_mid-rho*4*%pi*(r^3-a^3)/(3*eps0))$
res_shell_out_gauss :
  ratsimp(4*%pi*r^2*E_shell_out-rho*4*%pi*(b^3-a^3)/(3*eps0))$
res_shell_a : ratsimp(subst(a,r,E_shell_mid))$
res_shell_b : ratsimp(subst(b,r,E_shell_mid)-subst(b,r,E_shell_out))$

print("enhancement thick-shell middle Gauss residual =",res_shell_mid_gauss)$
print("enhancement thick-shell exterior Gauss residual =",res_shell_out_gauss)$
print("enhancement thick-shell inner-boundary residual =",res_shell_a)$
print("enhancement thick-shell outer-boundary residual =",res_shell_b)$

V_annulus :
  (b*Vb-a*Va)/(b-a)+a*b*(Va-Vb)/((b-a)*r)$
res_annulus_laplace : ratsimp(lap_radial(V_annulus))$
res_annulus_a : ratsimp(subst(a,r,V_annulus)-Va)$
res_annulus_b : ratsimp(subst(b,r,V_annulus)-Vb)$

print("enhancement annular-potential Laplace residual =",res_annulus_laplace)$
print("enhancement annular-potential inner-boundary residual =",res_annulus_a)$
print("enhancement annular-potential outer-boundary residual =",res_annulus_b)$

eps0_si : 88541878128/10^22$
E_line_num : (3/10^9)/(2*%pi*eps0_si*(1/5))$
E_sheet_num : (6/10^9)/(2*eps0_si)$
E_sphere_num : (4/10^6)*(1/50)/(3*eps0_si)$
res_num_line : round(bfloat(E_line_num))-270$
res_num_sheet : round(bfloat(E_sheet_num))-339$
res_num_sphere : round(bfloat(E_sphere_num/10))-301$

print("enhancement numerical line-field residual =",res_num_line)$
print("enhancement numerical sheet-field residual =",res_num_sheet)$
print("enhancement numerical sphere-field residual =",res_num_sphere)$

quit()$
