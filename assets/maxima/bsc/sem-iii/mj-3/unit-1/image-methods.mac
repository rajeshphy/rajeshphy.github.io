/* MJ-3 Unit I: exact checks for plane and sphere image solutions. */
kill(all)$
assume(a>R,R>0)$

print("MJ-3 Unit I -- method of images")$

/* Grounded plane, with k=1/(4*pi*eps0). */
Vplane : k*q*(1/sqrt(rho^2+(z-a)^2)-1/sqrt(rho^2+(z+a)^2))$
res_plane_boundary : ratsimp(subst(0,z,Vplane))$
sigma_from_V : radcan(-eps0*subst(0,z,diff(Vplane,z)))$
sigma_expected : -q*a/(2*%pi*(rho^2+a^2)^(3/2))$
res_plane_sigma :
  radcan(subst(1/(4*%pi*eps0),k,sigma_from_V)-sigma_expected)$
res_plane_charge :
  radcan(integrate(sigma_expected*2*%pi*rho,rho,0,inf)+q)$

print("grounded-plane boundary residual =",res_plane_boundary)$
print("grounded-plane surface-charge residual =",res_plane_sigma)$
print("grounded-plane total-induced-charge residual =",res_plane_charge)$

/* Grounded sphere. */
b : R^2/a$
qp : -q*R/a$
s2 : a^2+R^2-2*a*R*c$
sp2: b^2+R^2-2*b*R*c$
res_distance : ratsimp(sp2-(R^2/a^2)*s2)$
res_sphere_boundary : ratsimp(q/s+qp/(R*s/a))$

print("sphere image-distance residual =",res_distance)$
print("grounded-sphere boundary residual =",res_sphere_boundary)$

/* Surface charge from the exterior radial field, using s'=(R/a)s. */
Er_surface :
  q*(R-a*c)/s^3
  +qp*(R-b*c)/(R*s/a)^3$
Er_expected : -q*(a^2-R^2)/(R*s^3)$
res_sphere_sigma : ratsimp(Er_surface-Er_expected)$

print("grounded-sphere surface-field residual =",res_sphere_sigma)$

/* Exact angular integral after x=cos(theta). */
angular_integral :
  (1/(a*R))*(1/(a-R)-1/(a+R))$
Qind :
  -q*(a^2-R^2)*R*angular_integral/2$
res_sphere_charge : ratsimp(Qind+q*R/a)$

print("grounded-sphere total-induced-charge residual =",res_sphere_charge)$

image_force : q*qp/(a-b)^2$
force_expected : -q^2*R*a/(a^2-R^2)^2$
res_sphere_force : ratsimp(image_force-force_expected)$

print("grounded-sphere force residual =",res_sphere_force)$

/* Enhancement checks: solved problems and numerical answers. */
deltaV_cap : Qcap/(4*%pi*eps0)*(1/ra-1/rb)$
C_cap : Qcap/deltaV_cap$
C_cap_expected : 4*%pi*eps0*ra*rb/(rb-ra)$
res_spherical_capacitance : radcan(C_cap-C_cap_expected)$

U_plane : -q^2/(16*%pi*eps0*ha)$
F_plane_from_U : -diff(U_plane,ha)$
F_plane_expected : -q^2/(16*%pi*eps0*ha^2)$
res_plane_energy_force : ratsimp(F_plane_from_U-F_plane_expected)$

print("enhancement spherical-capacitance residual =",res_spherical_capacitance)$
print("enhancement plane energy-force residual =",res_plane_energy_force)$

eps0_si : 88541878128/10^22$
C_parallel_num_pf :
  eps0_si*(150/10000)/(15/10000)*10^12$
pressure_num : eps0_si*(3*10^6)^2/2$
q_image_num_nc : -6*(1/10)/(3/10)$
b_image_num_cm : ((1/10)^2/(3/10))*100$
res_num_capacitance : round(bfloat(10*C_parallel_num_pf))-885$
res_num_pressure : round(bfloat(10*pressure_num))-398$
res_num_image_charge : ratsimp(q_image_num_nc+2)$
res_num_image_position : round(bfloat(100*b_image_num_cm))-333$

print("enhancement numerical parallel-capacitance residual =",res_num_capacitance)$
print("enhancement numerical electrostatic-pressure residual =",res_num_pressure)$
print("enhancement numerical sphere-image-charge residual =",res_num_image_charge)$
print("enhancement numerical sphere-image-position residual =",res_num_image_position)$

quit()$
