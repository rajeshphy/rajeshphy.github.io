/* MJ-3 Unit III: exact checks for induction, energy, and galvanometer dynamics. */
kill(all)$
assume(J>0,wd>0,w0>0,beta>0,eta>0)$

print("MJ-3 Unit III -- induction and ballistic galvanometer")$

/* Coupled-coil reciprocity from exactness of dW. */
A1 : L1*I1+M21*I2$
A2 : M12*I1+L2*I2$
integrability : diff(A1,I2)-diff(A2,I1)$
res_reciprocity :
  ratsimp(subst(M,M21,subst(M,M12,integrability)))$

print("mutual-inductance reciprocity residual =",res_reciprocity)$

W : L1*I1^2/2+M*I1*I2+L2*I2^2/2$
res_energy_1 : ratsimp(diff(W,I1)-(L1*I1+M*I2))$
res_energy_2 : ratsimp(diff(W,I2)-(M*I1+L2*I2))$

print("coupled-energy I1-gradient residual =",res_energy_1)$
print("coupled-energy I2-gradient residual =",res_energy_2)$

Wself : L*I^2/2$
res_self_power : ratsimp(diff(Wself,I)-L*I)$
print("self-inductor energy derivative residual =",res_self_power)$

/* Maxwell correction and charge continuity. */
d_rho_dt : -divJ$
d_divD_dt : d_rho_dt$
res_continuity : ratsimp(divJ+d_divD_dt)$
print("displacement-current continuity residual =",res_continuity)$

/* Current-loop potential energy. */
U : -mu*B*cos(th)$
res_loop_energy : trigsimp(diff(U,th)-mu*B*sin(th))$
print("current-loop energy/torque residual =",res_loop_energy)$

/* Underdamped ballistic motion. */
kappa : J*(beta^2+wd^2)$
c : 2*J*beta$
A : G*q/(J*wd)$
theta : A*exp(-beta*t)*sin(wd*t)$
res_ode :
  trigsimp(ratsimp(J*diff(theta,t,2)+c*diff(theta,t)+kappa*theta))$
res_initial_angle : trigsimp(subst(0,t,theta))$
res_initial_impulse :
  trigsimp(ratsimp(J*subst(0,t,diff(theta,t))-G*q))$

print("free damped-motion ODE residual =",res_ode)$
print("initial-angle residual =",res_initial_angle)$
print("charge-impulse residual =",res_initial_impulse)$

/* First maximum: sin(alpha)=wd/w0, cos(alpha)=beta/w0. */
res_peak_condition :
  ratsimp(wd*(beta/w0)-beta*(wd/w0))$
theta1_from_solution :
  G*q/(J*wd)*exp(-beta*alpha/wd)*(wd/w0)$
theta1_expected :
  G*q/(J*w0)*exp(-beta*alpha/wd)$
res_first_throw : ratsimp(theta1_from_solution-theta1_expected)$

print("first-maximum derivative residual =",res_peak_condition)$
print("exact first-throw residual =",res_first_throw)$

/* Electromagnetic damping. */
eback : G*v$
iback : -eback/Rt$
tau_em : G*iback$
res_em_damping : ratsimp(tau_em+G^2*v/Rt)$
print("electromagnetic-damping torque residual =",res_em_damping)$

/* Same-side and alternating-side logarithmic decrements. */
delta_s : 2*%pi*beta/wd$
delta_a : %pi*beta/wd$
eta_def : beta/wd$
res_delta_same : ratsimp(delta_s-2*%pi*eta_def)$
res_delta_alt : ratsimp(delta_a-delta_s/2)$
res_weak_angle :
  radcan(limit(atan(1/eta)-%pi/2,eta,0,plus))$
res_correction_mapping :
  ratsimp((2*%pi*eta)/4-(%pi*eta)/2)$

print("same-side decrement residual =",res_delta_same)$
print("alternating-side decrement residual =",res_delta_alt)$
print("weak-damping arctangent-limit residual =",res_weak_angle)$
print("two decrement-convention correction residual =",res_correction_mapping)$

/* Enhancement checks: solved problems and numerical answers. */
M_solenoid_12 : mu_core*N1*N2*Area/len$
M_solenoid_21 : mu_core*N2*N1*Area/len$
res_solenoid_reciprocity : ratsimp(M_solenoid_12-M_solenoid_21)$

Id_inside : Icharge*rcap^2/Rcap^2$
B_inside : mu0*Icharge*rcap/(2*%pi*Rcap^2)$
B_outside : mu0*Icharge/(2*%pi*rcap)$
res_displacement_total :
  ratsimp(subst(Rcap,rcap,Id_inside)-Icharge)$
res_capacitor_B_boundary :
  ratsimp(subst(Rcap,rcap,B_inside)-subst(Rcap,rcap,B_outside))$

print("enhancement coaxial-solenoid reciprocity residual =",res_solenoid_reciprocity)$
print("enhancement capacitor displacement-current residual =",res_displacement_total)$
print("enhancement capacitor magnetic-boundary residual =",res_capacitor_B_boundary)$

emf_num : 200*(3/1000)/(2/100)$
energy_num : (1/2)*(1/2)*3^2$
torque_num : 50*(1/5)*(4/10^4)*(3/10)*(1/2)$
charge_num :
  ((2/10^7)*4*(8/100))/(2*%pi*100*(2/10^4)*(1/5))$
res_num_emf : ratsimp(emf_num-30)$
res_num_energy : ratsimp(100*energy_num-225)$
res_num_torque : ratsimp(10^4*torque_num-6)$
res_num_charge : round(bfloat(10^8*charge_num))-255$

print("enhancement numerical induced-emf residual =",res_num_emf)$
print("enhancement numerical magnetic-energy residual =",res_num_energy)$
print("enhancement numerical loop-torque residual =",res_num_torque)$
print("enhancement numerical ballistic-charge residual =",res_num_charge)$

quit()$
