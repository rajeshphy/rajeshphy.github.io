/* MJ-4 Waves and Optics, Unit II: exact symbolic audit.
   Run with: maxima -q -b mj4-unit-2-checks.mac
   Every displayed residual must be exactly 0. */

kill(all)$
assume(I1>0,I2>0,c>0)$

/* Two-beam intensity and visibility. */
Imax : (sqrt(I1)+sqrt(I2))^2$
Imin : (sqrt(I1)-sqrt(I2))^2$
r01 : radcan((Imax-Imin)/(Imax+Imin)
              -2*sqrt(I1*I2)/(I1+I2))$
print("U2-01 fringe-visibility residual =", r01)$

/* One-reflection-reversal thin-film phases. */
delta : 4*%pi*mu*t*cr/lam+%pi$
t_dark : m*lam/(2*mu*cr)$
t_bright : (m+1/2)*lam/(2*mu*cr)$
r02 : ratsimp(ev(delta,t=t_dark)-(2*m+1)*%pi)$
print("U2-02 reflected-dark phase residual =", r02)$

r03 : ratsimp(ev(delta,t=t_bright)-2*(m+1)*%pi)$
print("U2-03 reflected-bright phase residual =", r03)$

/* Fizeau wedge spacing. */
xm : m*lam/(2*mu*alpha)$
xmp1 : (m+1)*lam/(2*mu*alpha)$
r04 : ratsimp(xmp1-xm-lam/(2*mu*alpha))$
print("U2-04 wedge-fringe-spacing residual =", r04)$

/* Newton-ring diameters and measurements. */
D2(m) := 4*m*lam*R/mu$
r05 : ratsimp(D2(m+p)-D2(m)-4*p*lam*R/mu)$
print("U2-05 Newton diameter-difference residual =", r05)$

lambda_meas : mu*(D2(m+p)-D2(m))/(4*p*R)$
r06 : ratsimp(lambda_meas-lam)$
print("U2-06 Newton wavelength residual =", r06)$

Dair2(m) := 4*m*lam*R$
Dliq2(m) := 4*m*lam*R/mu$
r07 : ratsimp(Dair2(m)/Dliq2(m)-mu)$
print("U2-07 Newton liquid-index residual =", r07)$

/* Michelson wavelength, doublet, and cell checks. */
lambda_mich : 2*x/N$
r08 : ratsimp(2*x-N*lambda_mich)$
print("U2-08 Michelson wavelength residual =", r08)$

r09 : ratsimp(1/lam1-1/lam2-(lam2-lam1)/(lam1*lam2))$
print("U2-09 doublet reciprocal-difference residual =", r09)$

mu_cell : 1+N*lam/(2*tcell)$
r10 : ratsimp(2*tcell*(mu_cell-1)-N*lam)$
print("U2-10 Michelson cell-index residual =", r10)$

/* Michelson-Morley exact forms and second-order series. */
tpar : L/(c-v)+L/(c+v)$
r11 : ratsimp(ev(tpar,v=beta*c)-2*L/(c*(1-beta^2)))$
print("U2-11 parallel-arm exact residual =", r11)$

tperp : 2*L/sqrt(c^2-v^2)$
r12 : radcan(ev(tperp,v=beta*c)-2*L/(c*sqrt(1-beta^2)))$
print("U2-12 perpendicular-arm exact residual =", r12)$

tpar_series : ratdisrep(taylor(2*L/(c*(1-beta^2)),beta,0,2))$
r13 : ratsimp(tpar_series-2*L*(1+beta^2)/c)$
print("U2-13 parallel-arm O(beta^2) residual =", r13)$

tperp_series : ratdisrep(taylor(2*L/(c*sqrt(1-beta^2)),beta,0,2))$
r14 : ratsimp(tperp_series-2*L*(1+beta^2/2)/c)$
print("U2-14 perpendicular-arm O(beta^2) residual =", r14)$

/* Fabry-Perot denominator and Airy coefficient. */
den : (1-Rf*cos(d))^2+(Rf*sin(d))^2$
airy_den : (1-Rf)^2+4*Rf*sin(d/2)^2$
r15 : trigrat(expand(den-airy_den))$
print("U2-15 Fabry-Perot Airy-denominator residual =", r15)$

/* Fresnel-zone geometry and odd focal orders. */
rn2_exact : n*b*lam+n^2*lam^2/4$
r16 : ratsimp(b^2+rn2_exact-(b+n*lam/2)^2)$
print("U2-16 exact half-period-zone radius residual =", r16)$

qodd : 2*j+1$
r17 : ratsimp(2*qodd*%pi-2*(2*j+1)*%pi)$
print("U2-17 odd-order zone-plate phase residual =", r17)$

/* Fresnel-integral normalization. */
Iedge(Cv,Sv) := ((1/2+Cv)^2+(1/2+Sv)^2)/2$
r18 : ratsimp(Iedge(1/2,1/2)-1)$
print("U2-18 illuminated-edge limit residual =", r18)$

r19 : ratsimp(Iedge(0,0)-1/4)$
print("U2-19 geometrical-edge intensity residual =", r19)$

r20 : ratsimp(Iedge(-1/2,-1/2))$
print("U2-20 shadow-edge limit residual =", r20)$

r21 : ratsimp((dC^2+dS^2)/2
       -((dC+dS)^2+(dS-dC)^2)/4)$
print("U2-21 slit complex-normalization residual =", r21)$

/* Fraunhofer slit integral and double-slit factor. */
r22 : trigsimp(integrate(cos(q*x),x,-a/2,a/2)-2*sin(q*a/2)/q)$
print("U2-22 single-slit aperture-integral residual =", r22)$

r23 : trigrat(cos(phi-alpha)+cos(phi+alpha)
                 -2*cos(phi)*cos(alpha))$
print("U2-23 double-slit phasor residual =", r23)$

/* Finite geometric array check (the algebra is identical for arbitrary N). */
array7 : sum(z^j,j,0,6)$
r24 : ratsimp(expand((1-z)*array7-(1-z^7)))$
print("U2-24 seven-slit geometric-array residual =", r24)$

/* Circular-aperture Bessel antiderivative. */
bessel_primitive : rho*bessel_j(1,q*rho)/q$
bessel_raw : ev(diff(bessel_primitive,rho)-rho*bessel_j(0,q*rho),
                besselexpand=true)$
r25 : ratsimp(subst(2*bessel_j(1,q*rho)/(q*rho)-bessel_j(0,q*rho),
                    bessel_j(2,q*rho),bessel_raw))$
print("U2-25 circular-aperture Bessel-integral residual =", r25)$

/* Grating resolving-power cancellation. */
width : lam/(Nlines*dspace*cos(theta))$
separation : m*dlam/(dspace*cos(theta))$
dlam_rayleigh : lam/(m*Nlines)$
r26 : ratsimp(ev(separation-width,dlam=dlam_rayleigh))$
print("U2-26 grating Rayleigh residual =", r26)$

r27 : ratsimp(lam/dlam_rayleigh-m*Nlines)$
print("U2-27 grating resolving-power residual =", r27)$

/* Post 2025-06-27: solved problems and numerical answers. */
sp_visibility_Imax : (sqrt(9)+sqrt(4))^2$
r28 : ratsimp(sp_visibility_Imax-25)$
print("U2-28 solved visibility Imax residual =", r28)$

sp_visibility_Imin : (sqrt(9)-sqrt(4))^2$
r29 : ratsimp(sp_visibility_Imin-1)$
print("U2-29 solved visibility Imin residual =", r29)$

sp_visibility : (sp_visibility_Imax-sp_visibility_Imin)
                /(sp_visibility_Imax+sp_visibility_Imin)$
r30 : ratsimp(sp_visibility-12/13)$
print("U2-30 solved visibility residual =", r30)$
print("U2-A01 solved visibility answer =", sp_visibility)$

sp_newton_nm : (((5/1000)^2-(3/1000)^2)/(4*10))*10^9$
r31 : ratsimp(sp_newton_nm-400)$
print("U2-31 solved Newton wavelength residual =", r31)$
print("U2-A02 solved Newton wavelength answer (nm) =", sp_newton_nm)$

n_wedge_mm : ((600/10^9)/(2*(1/2000)))*1000$
r32 : ratsimp(n_wedge_mm-3/5)$
print("U2-32 wedge-spacing numerical residual =", r32)$
print("U2-A03 wedge-spacing answer (mm) =", n_wedge_mm)$

n_film_nm : (600/(4*(3/2)))$
r33 : ratsimp(n_film_nm-100)$
print("U2-33 film-thickness numerical residual =", r33)$
print("U2-A04 film-thickness answer (nm) =", n_film_nm)$

n_liquid_index : ((42/10)/(35/10))^2$
r34 : ratsimp(n_liquid_index-36/25)$
print("U2-34 Newton liquid-index numerical residual =", r34)$
print("U2-A05 Newton liquid-index answer =", n_liquid_index)$

n_ring_order : (4/1000)^2/(4*(500/10^9))$
r35 : ratsimp(n_ring_order-8)$
print("U2-35 Newton ring-order numerical residual =", r35)$
print("U2-A06 Newton ring-order answer =", n_ring_order)$

/* Post 2025-06-28: solved problems and numerical answers. */
sp_doublet_nm : 600^2/(2*180000)$
r36 : ratsimp(sp_doublet_nm-1)$
print("U2-36 solved doublet-separation residual =", r36)$
print("U2-A07 solved doublet-separation answer (nm) =", sp_doublet_nm)$

sp_airy_min : 1/(1+4*Rf/(1-Rf)^2)$
r37 : ratsimp(sp_airy_min-((1-Rf)/(1+Rf))^2)$
print("U2-37 solved Airy-minimum identity residual =", r37)$

sp_airy_R08 : ev(sp_airy_min,Rf=4/5)$
r38 : ratsimp(sp_airy_R08-1/81)$
print("U2-38 solved Airy-minimum numerical residual =", r38)$
print("U2-A08 solved Airy-minimum answer =", sp_airy_R08)$

n_mirror_mm : (400*(500/10^9)/2)*1000$
r39 : ratsimp(n_mirror_mm-1/10)$
print("U2-39 Michelson mirror-motion numerical residual =", r39)$
print("U2-A09 Michelson mirror-motion answer (mm) =", n_mirror_mm)$

n_cell_index : 1+120*(600/10^9)/(2*(5/100))$
r40 : ratsimp(n_cell_index-12509/12500)$
print("U2-40 Michelson cell-index numerical residual =", r40)$
print("U2-A10 Michelson cell-index answer =", n_cell_index)$

n_ether_shift : 2*11*(30000)^2/((500/10^9)*(3*10^8)^2)$
r41 : ratsimp(n_ether_shift-11/25)$
print("U2-41 ether-shift numerical residual =", r41)$
print("U2-A11 ether-shift answer (fringe) =", n_ether_shift)$

n_fsr_hz : (3*10^8)/(2*(3/200))$
r42 : ratsimp(n_fsr_hz-10^10)$
print("U2-42 Fabry-Perot free-spectral-range residual =", r42)$
print("U2-A12 Fabry-Perot free-spectral-range answer (GHz) =",
      n_fsr_hz/10^9)$

/* Post 2025-06-29: solved problems and numerical answers. */
sp_zone_area : %pi*(n*b*lam-(n-1)*b*lam)$
r43 : ratsimp(sp_zone_area-%pi*b*lam)$
print("U2-43 solved equal-zone-area residual =", r43)$

sp_slit_intensity : (1^2+1^2)/16$
r44 : ratsimp(sp_slit_intensity-1/8)$
print("U2-44 solved Babinet slit-intensity residual =", r44)$

sp_wire_intensity : (3^2+(-1)^2)/16$
r45 : ratsimp(sp_wire_intensity-5/8)$
print("U2-45 solved Babinet wire-intensity residual =", r45)$
print("U2-A13 solved Babinet answers (slit, wire) =",
      sp_slit_intensity, sp_wire_intensity)$

n_fresnel_u : (1/2000)*sqrt(2/((500/10^9)*1))$
r46 : radcan(n_fresnel_u-1)$
print("U2-46 Fresnel-coordinate numerical residual =", r46)$
print("U2-A14 Fresnel-coordinate answer =", n_fresnel_u)$

n_zone10_mm : sqrt(10*(500/10^9))*1000$
r47 : radcan(n_zone10_mm-sqrt(5))$
print("U2-47 tenth-zone-radius numerical residual =", r47)$
print("U2-A15 tenth-zone-radius answer (mm) =", n_zone10_mm)$

n_zone_f1 : (1/2000)^2/(500/10^9)$
n_zone_f3 : n_zone_f1/3$
r48a : ratsimp(n_zone_f1-1/2)$
r48b : ratsimp(n_zone_f3-1/6)$
print("U2-48a zone-plate principal-focus residual =", r48a)$
print("U2-48b zone-plate third-focus residual =", r48b)$
print("U2-A16 zone-plate answers f1,f3 (m) =", n_zone_f1, n_zone_f3)$

n_edge_boundary : Iedge(0,0)$
r49 : ratsimp(n_edge_boundary-1/4)$
print("U2-49 edge-boundary numerical residual =", r49)$
print("U2-A17 edge-boundary intensity answer =", n_edge_boundary)$

n_slit_fresnel : ((4/5)^2+(3/5)^2)/2$
r50 : ratsimp(n_slit_fresnel-1/2)$
print("U2-50 Fresnel-slit numerical residual =", r50)$
print("U2-A18 Fresnel-slit intensity answer =", n_slit_fresnel)$

/* Post 2025-06-30: solved problems and numerical answers. */
missing_sine : p*lam/a$
r51a : ratsimp(a*missing_sine-p*lam)$
r51b : ratsimp(3*a*missing_sine-3*p*lam)$
print("U2-51a solved missing-order slit residual =", r51a)$
print("U2-51b solved missing-order interference residual =", r51b)$

theta_arcsec : %pi/648000$
sp_telescope_D : (61/50)*(550/10^9)/theta_arcsec$
r52 : ratsimp(sp_telescope_D*theta_arcsec-(61/50)*(550/10^9))$
print("U2-52 solved telescope-aperture residual =", r52)$
print("U2-A19 solved telescope-aperture answer (m) =",
      float(sp_telescope_D))$

n_slit_angle : (500/10^9)/(2/10000)$
r53 : ratsimp(n_slit_angle-1/400)$
print("U2-53 single-slit-angle numerical residual =", r53)$
print("U2-A20 single-slit-angle answer (rad) =", n_slit_angle)$

n_double_angle : (600/10^9)/(5/10000)$
r54 : ratsimp(n_double_angle-3/2500)$
print("U2-54 double-slit-spacing numerical residual =", r54)$
print("U2-A21 double-slit-spacing answer (rad) =", n_double_angle)$

n_grating_sine : (500/10^9)/(1/600000)$
n_grating_angle : asin(n_grating_sine)$
r55 : trigsimp(sin(n_grating_angle)-3/10)$
print("U2-55 grating-angle numerical residual =", r55)$
print("U2-A22 grating-angle answer (degree) =",
      float(180*n_grating_angle/%pi))$

n_grating_power : 2*25000$
n_grating_dlam_nm : 600/n_grating_power$
r56a : ratsimp(n_grating_power-50000)$
r56b : ratsimp(n_grating_dlam_nm-3/250)$
print("U2-56a grating-power numerical residual =", r56a)$
print("U2-56b grating-interval numerical residual =", r56b)$
print("U2-A23 grating answers (power, delta lambda nm) =",
      n_grating_power, n_grating_dlam_nm)$

quit()$
