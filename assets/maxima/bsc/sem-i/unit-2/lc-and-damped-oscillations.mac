/* Ideal LC oscillation and all three free-damping regimes. */
kill(all)$
display2d:false$

wlc : 1/sqrt(L*C)$
q : Q*cos(wlc*t+phi)$
i : diff(q,t)$
print("LC differential-equation residual (must be 0):",
  radcan(trigsimp(diff(q,t,2)+q/(L*C))))$
print("LC total-energy residual (must be 0):",
  radcan(trigsimp(q^2/(2*C)+L*i^2/2-Q^2/(2*C))))$
print("LC energy-derivative residual (must be 0):",
  radcan(trigsimp(diff(q^2/(2*C)+L*i^2/2,t))))$

wd : sqrt(w0^2-beta^2)$
x_under : exp(-beta*t)*(C1*cos(wd*t)+C2*sin(wd*t))$
print("Underdamped-solution residual (must be 0):",
  radcan(trigsimp(diff(x_under,t,2)+2*beta*diff(x_under,t)+w0^2*x_under)))$

x_critical : (C1+C2*t)*exp(-beta*t)$
print("Critical-solution residual (must be 0):",
  factor(ev(diff(x_critical,t,2)+2*beta*diff(x_critical,t)
    +w0^2*x_critical,w0=beta)))$

s : sqrt(beta^2-w0^2)$
x_over : C1*exp((-beta+s)*t)+C2*exp((-beta-s)*t)$
print("Overdamped-solution residual (must be 0):",
  radcan(diff(x_over,t,2)+2*beta*diff(x_over,t)+w0^2*x_over))$

xdd_from_ode : -2*beta*xd-w0^2*x0$
b : 2*m*beta$
k : m*w0^2$
print("Mechanical-energy-loss residual (must be 0):",
  ratsimp(m*xd*xdd_from_ode+k*x0*xd+b*xd^2))$

Tlc : 2*%pi/wlc$
print("LC-period residual (must be 0):",
  radcan(Tlc-2*%pi*sqrt(L*C)))$

Td : 2*%pi/wd$
logdec : beta*Td$
print("Logarithmic-decrement residual (must be 0):",
  ratsimp(logdec-2*%pi*beta/wd))$

/* Solved problem 1: ideal LC oscillator. */
sp1_L : 1/4$
sp1_C : 1/100000$
sp1_Q : 1/25000$
sp1_w : 1/sqrt(sp1_L*sp1_C)$
sp1_T : 2*%pi/sp1_w$
sp1_Imax : sp1_w*sp1_Q$
sp1_E : sp1_Q^2/(2*sp1_C)$
print("Solved 1 answers [omega, period, Imax, energy]:",
  [float(sp1_w),float(sp1_T),float(sp1_Imax),sp1_E])$
print("Solved 1 check (must be 0):",
  radcan((sp1_w-200*sqrt(10))
    +(sp1_T-%pi/(100*sqrt(10)))
    +(sp1_Imax-sqrt(10)/125)
    +(sp1_E-1/12500)))$

/* Solved problem 2: underdamped initial-value motion. */
sp2_beta : 3$
sp2_w0 : 5$
sp2_wd : sqrt(sp2_w0^2-sp2_beta^2)$
sp2_C : 1/10$
sp2_D : 3/40$
sp2_x : exp(-sp2_beta*t)
  *(sp2_C*cos(sp2_wd*t)+sp2_D*sin(sp2_wd*t))$
sp2_logdec : 2*%pi*sp2_beta/sp2_wd$
sp2_ratio : exp(-sp2_logdec)$
print("Solved 2 answers [omega_d, D, decrement, cycle ratio]:",
  [sp2_wd,sp2_D,sp2_logdec,float(sp2_ratio)])$
print("Solved 2 ODE residual (must be 0):",
  radcan(trigsimp(diff(sp2_x,t,2)
    +2*sp2_beta*diff(sp2_x,t)+sp2_w0^2*sp2_x)))$
print("Solved 2 initial-data check (must be 0):",
  trigsimp((subst(0,t,sp2_x)-1/10)
    +subst(0,t,diff(sp2_x,t))))$
print("Solved 2 answer check (must be 0):",
  ratsimp((sp2_wd-4)+(sp2_D-3/40)
    +(sp2_logdec-3*%pi/2)))$

/* Numerical problems. */
n1_L : 1/5$
n1_C : 1/125000$
n1_Q0 : 1/25000$
n1_q : 1/50000$
n1_i : -sqrt((n1_Q0^2-n1_q^2)/(n1_L*n1_C))$
n1_E : n1_Q0^2/(2*n1_C)$
n1_UE : n1_q^2/(2*n1_C)$
n1_UB : n1_L*n1_i^2/2$
n1_Efrac : n1_UE/n1_E$
n1_Bfrac : n1_UB/n1_E$
print("Numerical 1 answers [current, electric fraction, magnetic fraction]:",
  [float(n1_i),n1_Efrac,n1_Bfrac])$
print("Numerical 1 current check (must be 0):",
  radcan(n1_i+sqrt(30)/200))$
print("Numerical 1 electric-fraction check (must be 0):",
  ratsimp(n1_Efrac-1/4))$
print("Numerical 1 magnetic-fraction check (must be 0):",
  ratsimp(n1_Bfrac-3/4))$
print("Numerical 1 energy-balance check (must be 0):",
  ratsimp(n1_UE+n1_UB-n1_E))$

n2_Vmax : (12/1000000)/(3/1000000)$
print("Numerical 2 answer, maximum voltage:",n2_Vmax)$
print("Numerical 2 check (must be 0):",ratsimp(n2_Vmax-4))$

n3_A1 : 3/250$
n3_A2 : 9/1000$
n3_dt : 4/5$
n3_m : 1/2$
n3_tau : n3_dt/log(n3_A1/n3_A2)$
n3_b : 2*n3_m/n3_tau$
print("Numerical 3 answers [amplitude relaxation time, damping coefficient]:",
  [float(n3_tau),float(n3_b)])$
print("Numerical 3 relaxation-time check (must be 0):",
  ratsimp(n3_tau-4/(5*log(4/3))))$
print("Numerical 3 damping-coefficient check (must be 0):",
  ratsimp(n3_b-5*log(4/3)/4))$
print("Numerical 3 measured-decay check (must be 0):",
  radcan(n3_A1*exp(-n3_dt/n3_tau)-n3_A2))$

n4_beta : 12/(2*2)$
n4_w0 : sqrt(18/2)$
print("Numerical 4 answers [beta, omega_0]:",[n4_beta,n4_w0])$
print("Numerical 4 check (must be 0):",
  ratsimp((n4_beta-3)+(n4_w0-3)))$

n5_beta : 8/(2*1)$
n5_wd : sqrt(100-n5_beta^2)$
n5_Td : 2*%pi/n5_wd$
print("Numerical 5 answers [omega_d, damped period]:",
  [n5_wd,float(n5_Td)])$
print("Numerical 5 check (must be 0):",
  radcan((n5_wd-2*sqrt(21))
    +(n5_Td-%pi/sqrt(21))))$

n6_beta : 6/(2*1)$
n6_s : sqrt(n6_beta^2-8)$
n6_lambda1 : -n6_beta+n6_s$
n6_lambda2 : -n6_beta-n6_s$
print("Numerical 6 answers [lambda_1, lambda_2]:",
  [n6_lambda1,n6_lambda2])$
print("Numerical 6 check (must be 0):",
  ratsimp((n6_lambda1+2)+(n6_lambda2+4)))$

quit();
