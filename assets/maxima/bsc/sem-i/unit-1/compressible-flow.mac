/* Isothermal compressible capillary flow and ideal Rankine method. */
kill(all)$
display2d:false$

C : %pi*a^4*(p1^2-p2^2)/(16*eta*l)$
Q2 : C/p2$
eta_outlet : %pi*a^4*(p1^2-p2^2)*t/(16*l*p2*V2)$

print("Outlet-flow viscosity residual (must be 0):",
  ratsimp(ev(Q2,eta=eta_outlet)-V2/t))$
print("Pressure-factorization residual (must be 0):",
  expand(p1^2-p2^2-(p1-p2)*(p1+p2)))$

pm : (p1+p2)/2$
Qm : ratsimp(C/pm)$
Qm_expected : %pi*a^4*(p1-p2)/(8*eta*l)$
print("Mean-pressure flow residual (must be 0):",
  ratsimp(Qm-Qm_expected))$

Q2_drop : ratsimp(ev(Q2,p1=p2+d))$
Q2_drop_expected : %pi*a^4*d/(8*eta*l)*(1+d/(2*p2))$
print("Small-drop expansion residual (must be 0):",
  ratsimp(Q2_drop-Q2_drop_expected))$

/* Exact closed-loop Rankine method. */
pL : P-dpr+dpr*VL/Vtot$
pH : P+dpr*VL/Vtot$
print("Rankine pressure-difference residual (must be 0):",
  ratsimp(pH-pL-dpr))$
print("Rankine gas-content residual (must be 0):",
  ratsimp(pL*VL+pH*(Vtot-VL)-P*Vtot))$

throughput : %pi*a^4*(pH^2-pL^2)/(16*eta*l)$
storage_derivative : diff(pL*VL,VL)$
dt_dVL : ratsimp(storage_derivative/throughput)$
dt_dVL_expected : 16*eta*l/(%pi*a^4*dpr)
  *(P-dpr+2*dpr*VL/Vtot)/(2*P-dpr+2*dpr*VL/Vtot)$
print("Rankine differential-time residual (must be 0):",
  ratsimp(dt_dVL-dt_dVL_expected))$

Iprimitive : VL-P*Vtot/(2*dpr)
  *log(2*P-dpr+2*dpr*VL/Vtot)$
ratio_integrand : (P-dpr+2*dpr*VL/Vtot)
  /(2*P-dpr+2*dpr*VL/Vtot)$
print("Rankine antiderivative residual (must be 0):",
  ratsimp(diff(Iprimitive,VL)-ratio_integrand))$

Iab : (Vb-Va)-P*Vtot/(2*dpr)
  *log((2*P-dpr+2*dpr*Vb/Vtot)
    /(2*P-dpr+2*dpr*Va/Vtot))$
print("Rankine small-pressure integral residual (must be 0):",
  ratsimp(limit(Iab,dpr,0)-(Vb-Va)/2))$

eta_rankine_small : %pi*a^4*(m*g/A)*t/(16*l*((Vb-Va)/2))$
print("Rankine quoted-limit residual (must be 0):",
  ratsimp(ev(eta_rankine_small,Vb-Va=Omega)
    -%pi*a^4*m*g*t/(8*l*A*Omega)))$

/* Conserved ideal-gas mass rate. */
mdot_local : p/(Rs*T)*q$
print("Ideal-gas mass-rate residual (must be 0):",
  ratsimp(ev(mdot_local,q=C0/p)-C0/(Rs*T)))$

/* Solved problem 1. */
a1 : 3/20000$
l1 : 1/2$
eta1 : 18/1000000$
p11 : 150000$
p21 : 100000$
Rs1 : 287$
T1 : 300$
C1 : %pi*a1^4*(p11^2-p21^2)/(16*eta1*l1)$
Q11 : C1/p11$
Q21 : C1/p21$
mdot1 : C1/(Rs1*T1)$
print("Solved 1 inlet-throughput residual (must be 0):",
  ratsimp(p11*Q11-C1))$
print("Solved 1 outlet-throughput residual (must be 0):",
  ratsimp(p21*Q21-C1))$
print("Solved 1 volume-rate ratio residual (must be 0):",
  ratsimp(Q21/Q11-3/2))$
print("Solved 1 displayed C rounding check (must be 0):",
  round(float(10000*C1))-1381)$
print("Solved 1 displayed inlet-rate check (must be 0):",
  round(float(10000000000*Q11))-9204)$
print("Solved 1 displayed outlet-rate check (must be 0):",
  round(float(1000000000*Q21))-1381)$
print("Solved 1 displayed mass-rate check (must be 0):",
  round(float(1000000000*mdot1))-1603)$

/* Solved problem 2. */
P2 : 100000$
dpr2 : 10000$
Vtot2 : 1/10000$
Va2 : 1/50000$
Vb2 : 3/50000$
a2 : 1/5000$
l2 : 2/5$
t2 : 50$
I2 : (Vb2-Va2)-P2*Vtot2/(2*dpr2)
  *log((2*P2-dpr2+2*dpr2*Vb2/Vtot2)
    /(2*P2-dpr2+2*dpr2*Va2/Vtot2))$
eta2 : %pi*a2^4*dpr2*t2/(16*l2*I2)$
eta2_small : %pi*a2^4*dpr2*t2/(8*l2*(Vb2-Va2))$
err2 : 100*(eta2-eta2_small)/eta2$
print("Solved 2 exact timing residual (must be 0):",
  ratsimp(16*eta2*l2*I2/(%pi*a2^4*dpr2)-t2))$
print("Solved 2 displayed integral check (must be 0):",
  round(float(1000000000*I2))-19795)$
print("Solved 2 displayed exact-viscosity check (must be 0):",
  round(float(1000000000*eta2))-19838)$
print("Solved 2 displayed approximate-viscosity check (must be 0):",
  round(float(1000000000*eta2_small))-19635)$
print("Solved 2 displayed percentage check (must be 0):",
  round(float(100*err2))-102)$

/* Six numerical problems. */
n1_a : 1/10000$
n1_l : 2/5$
n1_eta : 18/1000000$
n1_p2 : 100000$
n1_Q2 : 12/100000000$
n1_p1 : sqrt(n1_p2^2
  +16*n1_eta*n1_l*n1_p2*n1_Q2/(%pi*n1_a^4))$
print("Numerical 1 displayed inlet-pressure check (must be 0):",
  round(float(n1_p1/100))-1200)$

n2_a : 12/100000$
n2_l : 1/2$
n2_p1 : 130000$
n2_p2 : 100000$
n2_Q2 : (80/1000000)/120$
n2_eta : %pi*n2_a^4*(n2_p1^2-n2_p2^2)
  /(16*n2_l*n2_p2*n2_Q2)$
print("Numerical 2 displayed viscosity check (must be 0):",
  round(float(1000000000*n2_eta))-8428)$

n3_ratio : 80000/160000$
print("Numerical 3 volume-rate ratio residual (must be 0):",
  ratsimp(n3_ratio-1/2))$

n4_P : 100000$
n4_dpr : 8000$
n4_Vtot : 120/1000000$
n4_VL : 45/1000000$
n4_pL : ev(pL,P=n4_P,dpr=n4_dpr,
  Vtot=n4_Vtot,VL=n4_VL)$
n4_pH : ev(pH,P=n4_P,dpr=n4_dpr,
  Vtot=n4_Vtot,VL=n4_VL)$
print("Numerical 4 low-pressure chamber residual (must be 0):",
  ratsimp(n4_pL-95000))$
print("Numerical 4 high-pressure chamber residual (must be 0):",
  ratsimp(n4_pH-103000))$
print("Numerical 4 gas-content residual (must be 0):",
  ratsimp(n4_pL*n4_VL+n4_pH*(n4_Vtot-n4_VL)
    -n4_P*n4_Vtot))$

n5_eta : (18/1000000)*55/40$
print("Numerical 5 calibration-viscosity residual (must be 0):",
  ratsimp(n5_eta-2475/100000000))$

n6_excess : 20000/(2*100000)$
print("Numerical 6 excess-rate percentage residual (must be 0):",
  ratsimp(100*n6_excess-10))$

quit();
