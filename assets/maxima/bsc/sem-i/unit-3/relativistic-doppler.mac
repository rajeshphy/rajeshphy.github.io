/* Relativistic Doppler equivalent forms and low-speed term. */
kill(all)$ display2d:false$
g : 1/sqrt(1-b^2)$
recede1 : 1/(g*(1+b))$
recede2 : sqrt((1-b)/(1+b))$
print("receding-factor residual (must be 0):",ratsimp(radcan(recede1-recede2)))$
approach1 : 1/(g*(1-b))$
approach2 : sqrt((1+b)/(1-b))$
print("approaching-factor residual (must be 0):",ratsimp(radcan(approach1-approach2)))$
first_derivative : subst(b=0,diff(recede1,b))$
print("low-speed linear coefficient residual (must be 0):",ratsimp(first_derivative+1))$
angular : 1/(g*(1-b*mu))$
print("angular receding limit residual (must be 0):",ratsimp(subst(mu=-1,angular)-recede1))$
print("angular approaching limit residual (must be 0):",ratsimp(subst(mu=1,angular)-approach1))$
print("transverse factor residual (must be 0):",ratsimp(subst(mu=0,angular)-1/g))$

/* Solved problems and numerical problems. */
c0 : 299792458$

p1_R : 5/4$
p1_b : (p1_R^2-1)/(p1_R^2+1)$
p1_v : p1_b*c0$
print("solved 1 inferred-beta residual (must be 0):",ratsimp(p1_b-9/41))$
print("solved 1 speed rounding residual (must be 0):",
  round(float(p1_v/10^5))-658)$

p2_b : 3/5$ p2_g : 5/4$ p2_mu : 1/3$
p2_factor : 1/(p2_g*(1-p2_b*p2_mu))$
print("solved 2 zero-shift residual (must be 0):",ratsimp(p2_factor-1))$
print("solved 2 angle rounding residual (must be 0):",
  round(float(acos(p2_mu)*180/%pi*100))-7053)$

q1_factor : sqrt((1-4/5)/(1+4/5))$
print("numerical 1 receding-factor residual (must be 0):",radcan(q1_factor-1/3))$
q2_wavelength_factor : sqrt((1-3/5)/(1+3/5))$
print("numerical 2 approaching-wavelength residual (must be 0):",
  radcan(500*q2_wavelength_factor-250))$
q3_factor : sqrt(1-(4/5)^2)$
print("numerical 3 transverse-frequency residual (must be 0):",
  radcan(500*q3_factor-300))$
q4_factor : 1/((5/4)*(1-(3/5)*(1/2)))$
print("numerical 4 angular-factor residual (must be 0):",ratsimp(q4_factor-8/7))$
q5_nu_app : 800$ q5_nu_rec : 200$
q5_ratio : q5_nu_app/q5_nu_rec$
q5_b : (q5_ratio-1)/(q5_ratio+1)$
q5_nu0 : sqrt(q5_nu_app*q5_nu_rec)$
q5_app_reconstructed : q5_nu0*sqrt((1+q5_b)/(1-q5_b))$
q5_rec_reconstructed : q5_nu0*sqrt((1-q5_b)/(1+q5_b))$
print("numerical 5 paired-speed residual (must be 0):",
  ratsimp(q5_b-3/5))$
print("numerical 5 rest-frequency residual (must be 0):",
  radcan(q5_nu0-400))$
print("numerical 5 approaching-reconstruction residual (must be 0):",
  radcan(q5_app_reconstructed-q5_nu_app))$
print("numerical 5 receding-reconstruction residual (must be 0):",
  radcan(q5_rec_reconstructed-q5_nu_rec))$
q6_b : 1/10000$
q6_first_nm : 600*q6_b$
q6_exact_nm : 600*(sqrt((1+q6_b)/(1-q6_b))-1)$
print("numerical 6 first-order shift residual (must be 0):",
  ratsimp(q6_first_nm-3/50))$
print("numerical 6 exact-shift rounding residual (must be 0):",
  round(float(q6_exact_nm*10^6))-60003)$
quit();
