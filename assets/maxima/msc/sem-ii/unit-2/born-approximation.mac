/*
  Born approximation
  Maxima 5.49-compatible verification worksheet

  Run with:
      maxima --very-quiet -b born-approximation.mac
*/

kill(all)$
display2d:false$
fpprintprec:12$

print("BORN APPROXIMATION")$
assume(q>0,r>0,lambda>0,k>0,mu>0,hbar>0)$

/* 1. Outgoing Green-function normalization. */
green_C : -1/(4*%pi)$
green_residual : ratsimp(-4*%pi*green_C-1)$
print("Small-sphere Green normalization residual (must be 0):",
      green_residual)$

/* 2. Elastic momentum-transfer identity. */
q2_elastic : 2*k^2*(1-cos(theta))$
q2_expected : 4*k^2*sin(theta/2)^2$
q_residual :
    ratsimp(trigreduce(q2_elastic-q2_expected))$
print("q^2=4k^2 sin^2(theta/2) residual (must be 0):",
      q_residual)$

/* 3. Angular Fourier transform of a central potential. */
angular_integral :
    2*%pi*integrate(cos(q*r*x),x,-1,1)$
angular_expected : 4*%pi*sin(q*r)/(q*r)$
angular_residual :
    ratsimp(trigreduce(angular_integral-angular_expected))$
print("Central-potential angular-integral residual (must be 0):",
      angular_residual)$

/* 4. Yukawa or screened-Coulomb radial transform. */
yukawa_integral :
    integrate(exp(-lambda*r)*sin(q*r),r,0,inf)$
yukawa_expected : q/(q^2+lambda^2)$
yukawa_residual :
    ratsimp(yukawa_integral-yukawa_expected)$
print("Yukawa radial-integral residual (must be 0):",
      yukawa_residual)$

/* 5. Coulomb limit of the Born result compared with Rutherford. */
q_elastic : 2*k*sin(theta/2)$
f_coulomb : -2*mu*kappa/(hbar^2*q_elastic^2)$
Ekin : hbar^2*k^2/(2*mu)$
rutherford :
    (kappa/(4*Ekin))^2/sin(theta/2)^4$
coulomb_residual :
    ratsimp(f_coulomb^2-rutherford)$
print("Born-Coulomb/Rutherford residual (must be 0):",
      coulomb_residual)$

quit();
