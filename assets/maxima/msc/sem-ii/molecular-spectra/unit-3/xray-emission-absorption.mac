/* Symbolic checks for X-ray principles, emission, and absorption. */
kill(all)$
display2d:false$

print("X-RAY SYMBOLIC CHECKS")$

/* Duane-Hunt endpoint. */
lambda_min : h*c/(q_e*V)$
print("Duane-Hunt residual =",
      ratsimp(lambda_min*q_e*V/(h*c)-1))$

/* Screened one-electron Bohr model. */
r_n : 4*%pi*eps0*hbar^2*n^2/(m_e*q_e^2*Zeff)$
v_n : n*hbar/(m_e*r_n)$
force_residual :
  ratsimp(m_e*v_n^2/r_n
          - Zeff*q_e^2/(4*%pi*eps0*r_n^2))$
print("Coulomb-orbit force residual =", force_residual)$

E_from_KU :
  ratsimp(m_e*v_n^2/2
          - Zeff*q_e^2/(4*%pi*eps0*r_n))$
E_expected :
  -m_e*q_e^4*Zeff^2/
   (2*(4*%pi*eps0)^2*hbar^2*n^2)$
print("Bound-energy residual =",
      ratsimp(E_from_KU-E_expected))$

/* K-alpha and K-beta screened-hydrogenic factors. */
nu_Kalpha : c*R*Zeff^2*(1-1/2^2)$
nu_Kbeta  : c*R*Zeff^2*(1-1/3^2)$
print("K-alpha factor residual =",
      ratsimp(nu_Kalpha/Zeff^2-3*c*R/4))$
print("K-beta factor residual =",
      ratsimp(nu_Kbeta/Zeff^2-8*c*R/9))$
print("K-beta minus K-alpha residual =",
      ratsimp(nu_Kbeta-nu_Kalpha-5*c*R*Zeff^2/36))$

/* An emission line is below its parent absorption edge. */
E_Kedge : B_K$
E_Kalpha : B_K-B_L$
E_Kbeta : B_K-B_M$
print("K-edge minus K-alpha residual =",
      ratsimp(E_Kedge-E_Kalpha-B_L))$
print("K-beta minus K-alpha residual =",
      ratsimp(E_Kbeta-E_Kalpha-(B_L-B_M)))$

/* Beer-Lambert differential equation and half-value thickness. */
I_of_x : I0*exp(-mu_X*x)$
print("Beer-Lambert ODE residual =",
      ratsimp(diff(I_of_x,x)+mu_X*I_of_x))$
x_half : log(2)/mu_X$
print("Half-value transmission residual =",
      radcan(exp(-mu_X*x_half)-1/2))$

/* Bragg path difference. */
path_difference : d*sin(theta)+d*sin(theta)$
print("Bragg path-difference residual =",
      ratsimp(path_difference-2*d*sin(theta)))$

/* Numerical scale: 30 kV gives about 0.04133 nm. */
h_SI : 6.62607015b-34$
c_SI : 2.99792458b8$
q_SI : 1.602176634b-19$
lambda_30kV_nm :
  bfloat(h_SI*c_SI/(q_SI*30000)*1b9)$
print("30 kV cutoff wavelength in nm =", lambda_30kV_nm)$

quit()$
